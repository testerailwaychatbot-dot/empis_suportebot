# ===== Obrigatórias nos dois modos =====
VERIFY_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===== Modo Meta (WhatsApp Cloud API, padrão) =====
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
APP_SECRET=

# ===== Opcionais =====
# WA_MODE=qr            # usa Baileys (WhatsApp Web, não oficial) em vez da API da Meta
# AUTH_DIR=/data/auth   # pasta da sessão do Baileys (no Railway, aponte para um Volume)
# GRAPH_URL=            # padrão: https://graph.facebook.com/v21.0
# SIMULATOR=1           # SÓ para testes locais. Nunca em produção.

# PORT: definida automaticamente pelo Railway. Não configure.

# ===== Google Calendar (opcional; recomendado para agendamentos) =====
# Ative somente depois de compartilhar a agenda com o e-mail da conta de serviço.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_TIME_ZONE=America/Sao_Paulo
GOOGLE_CALENDAR_DURATION_MINUTES=60
